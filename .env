# 前端 H5 开发端口（start.sh 与后端约定为 5274）
VITE_APP_PORT=5274

# 后端 NestJS 服务地址（含 /v1 前缀）
VITE_SERVER_BASEURL=http://localhost:3001/v1

# 请求超时（毫秒）
VITE_SERVER_TIMEOUT=10000

# 是否启用代理（前端直连绝对地址，无需代理）
VITE_APP_PROXY=false
VITE_APP_PROXY_PREFIX=/api

# 生产构建时删除 console
VITE_DELETE_CONSOLE=false

# 是否输出 sourcemap
VITE_SHOW_SOURCEMAP=true
