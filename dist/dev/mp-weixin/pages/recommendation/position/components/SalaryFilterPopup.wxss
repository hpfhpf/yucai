.popup.data-v-d220805f {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
}
.popup__mask.data-v-d220805f {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  transition: background 180ms ease;
}
.popup__mask--show.data-v-d220805f {
  background: rgba(0, 0, 0, 0.32);
}
.panel.data-v-d220805f {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 18rpx 46rpx rgba(0, 0, 0, 0.1);
  transform: translateY(-10rpx);
  opacity: 0;
  transition: transform 180ms ease, opacity 180ms ease;
}
.panel--show.data-v-d220805f {
  transform: translateY(0);
  opacity: 1;
}
.panel__scroll.data-v-d220805f {
  max-height: 520rpx;
  max-height: 60vh;
}
.grid.data-v-d220805f {
  display: grid;
  gap: 18rpx;
  padding: 18rpx 22rpx 26rpx;
  box-sizing: border-box;
}
.pill.data-v-d220805f {
  min-width: 0;
  height: 72rpx;
}
.pill--pressed.data-v-d220805f {
  opacity: 0.92;
  transform: scale(0.99);
}
.pill__inner.data-v-d220805f {
  height: 72rpx;
  border-radius: 14rpx;
  background: rgba(0, 0, 0, 0.035);
  border: 1px solid rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.pill__inner--active.data-v-d220805f {
  background: rgba(30, 91, 255, 0.1);
  border-color: rgba(30, 91, 255, 0.22);
}
.pill__text.data-v-d220805f {
  font-size: 28rpx;
  font-weight: 750;
  color: rgba(0, 0, 0, 0.78);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.pill__inner--active .pill__text.data-v-d220805f {
  color: rgba(30, 91, 255, 0.98);
}