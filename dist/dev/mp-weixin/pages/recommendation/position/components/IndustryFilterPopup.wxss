.popup.data-v-93ee5e8a {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
}
.popup__mask.data-v-93ee5e8a {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  transition: background 180ms ease;
}
.popup__mask--show.data-v-93ee5e8a {
  background: rgba(0, 0, 0, 0.32);
}
.panel.data-v-93ee5e8a {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 18rpx 46rpx rgba(0, 0, 0, 0.1);
  transform: translateY(-10rpx);
  opacity: 0;
  transition: transform 180ms ease, opacity 180ms ease;
}
.panel--show.data-v-93ee5e8a {
  transform: translateY(0);
  opacity: 1;
}
.panel__scroll.data-v-93ee5e8a {
  max-height: 520rpx;
  max-height: 60vh;
}
.grid.data-v-93ee5e8a {
  display: grid;
  gap: 0;
  padding: 18rpx 22rpx 26rpx;
  box-sizing: border-box;
}
.item.data-v-93ee5e8a {
  height: 86rpx;
  display: flex;
  align-items: center;
}
.item--pressed.data-v-93ee5e8a {
  opacity: 0.9;
}
.item__text.data-v-93ee5e8a {
  font-size: 30rpx;
  font-weight: 750;
  color: rgba(0, 0, 0, 0.78);
}
.item__text--active.data-v-93ee5e8a {
  color: rgba(30, 91, 255, 0.98);
