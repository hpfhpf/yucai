.data-v-da3c8f3c:root,
page.data-v-da3c8f3c {
  --app-bg: #eef3ff;
  --app-bg-soft: #eef4ff;
  --app-surface: rgba(255, 255, 255, 0.96);
  --app-surface-strong: rgba(255, 255, 255, 0.98);
  --app-surface-muted: rgba(255, 255, 255, 0.92);
  --app-text-primary: rgba(0, 0, 0, 0.86);
  --app-text-secondary: rgba(0, 0, 0, 0.56);
  --app-text-muted: rgba(0, 0, 0, 0.36);
  --app-line: rgba(0, 0, 0, 0.06);
  --app-line-strong: rgba(0, 0, 0, 0.1);
  --app-primary: #1e5bff;
  --app-primary-alt: #2a67ff;
  --app-accent: #ff7a00;
  --app-shadow-card: 0 16rpx 44rpx rgba(30, 60, 140, 0.1);
  --app-shadow-card-strong: 0 18rpx 54rpx rgba(18, 70, 190, 0.18);
  --app-radius-xs: 10rpx;
  --app-radius-sm: 14rpx;
  --app-radius-md: 18rpx;
  --app-radius-lg: 22rpx;
  --app-radius-pill: 999rpx;
  --app-timing-fast: 0.18s;
  --app-timing-base: 0.24s;
  --app-ease-standard: ease;
}
.page.data-v-da3c8f3c {
  min-height: 100vh;
  background: var(--app-bg);
  display: flex;
  flex-direction: column;
}
.header.data-v-da3c8f3c {
  background-color: #FFF;
  flex-shrink: 0;
}
.topBar.data-v-da3c8f3c {
  background: #fff;
  padding: 14rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--app-line);
  flex: 0 0 auto;
}
.topBar__left.data-v-da3c8f3c {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}
.topBar__bubbleIcon.data-v-da3c8f3c {
  width: 34rpx;
  height: 34rpx;
  border-radius: 10rpx;
  background: url("data:image/png;base64,") no-repeat center center;
  background-size: contain;
  position: relative;
  flex: 0 0 auto;
}
.topBar__bubbleIcon.data-v-da3c8f3c::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 12rpx;
  border-radius: 6rpx;
  border: 3rpx solid var(--app-primary);
  transform: translate(-50%, -50%);
}
.topBar__text.data-v-da3c8f3c {
  font-size: 26rpx;
  color: var(--app-text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.topBar__cta.data-v-da3c8f3c {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--app-primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}
.topBar__cta--pressed.data-v-da3c8f3c {
  opacity: 0.92;
}
.chat.data-v-da3c8f3c {
  flex: 1 1 auto;
  padding: 18rpx 24rpx 0;
  box-sizing: border-box;
}
.status.data-v-da3c8f3c {
  text-align: center;
  margin-top: 8rpx;
  margin-bottom: 18rpx;
}
.status__line.data-v-da3c8f3c {
