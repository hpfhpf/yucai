.wd-card {
  position: relative;
  background-color: var(--wot-card-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
  border-radius: var(--wot-card-radius, var(--wot-radius-large, var(--wot-n-8, 8px)));
  box-shadow: var(--wot-card-shadow, var(--wot-n-0, 0px) var(--wot-n-2, 2px) var(--wot-n-8, 8px) var(--wot-opac-2_04, rgba(0, 0, 0, 0.0392156863)));
  overflow: hidden;
  transition: var(--wot-card-transition, box-shadow 0.3s ease);
  margin: 0 var(--wot-card-margin-horizontal, var(--wot-spacing-extra-loose, var(--wot-n-16, 16px)));
}
.wd-card:not(:last-child) {
  margin-bottom: var(--wot-card-margin-bottom, var(--wot-spacing-extra-loose, var(--wot-n-16, 16px)));
}
.wd-card__title {
  width: 100%;
  padding: var(--wot-card-title-padding, var(--wot-padding-loose, var(--wot-n-12, 12px)) var(--wot-padding-extra-loose, var(--wot-n-16, 16px)));
  box-sizing: border-box;
  display: flex;
}
.wd-card__title-text {
  width: 100%;
  color: var(--wot-card-title-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
  font-size: var(--wot-card-title-font-size, var(--wot-typography-title-size-main, var(--wot-n-18, 18px)));
  line-height: var(--wot-card-title-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
  font-weight: var(--wot-card-title-font-weight, var(--wot-font-weight-medium, 600));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wd-card__content {
  color: var(--wot-card-content-color, var(--wot-text-secondary, var(--wot-coolgrey-8, #4e5369)));
  font-size: var(--wot-card-content-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-card-content-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
  padding: var(--wot-card-content-padding, var(--wot-padding-main, var(--wot-n-10, 10px)) var(--wot-padding-loose, var(--wot-n-12, 12px)));
  box-sizing: border-box;
}
.wd-card__footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: var(--wot-card-footer-padding, var(--wot-padding-tight, var(--wot-n-8, 8px)) var(--wot-padding-loose, var(--wot-n-12, 12px)));
  position: relative;
}
.wd-card__footer::after {
  position: absolute;
  display: block;
  content: "";
  width: calc(100% - var(--wot-padding-loose, var(--wot-n-12, 12px)) * 2);
  height: var(--wot-stroke-main, var(--wot-n-1, 1px));
  left: var(--wot-padding-loose, var(--wot-n-12, 12px));
  top: 0;
  transform: scaleY(0.5);
  background: var(--wot-card-footer-border-color, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
}
.wd-card--rectangle {
  margin-left: 0;
  margin-right: 0;
  border-radius: 0;
  box-shadow: none;
}
.wd-card--rectangle .wd-card__content {
  position: relative;
}
.wd-card--rectangle .wd-card__content::after {
  position: absolute;
  display: block;
  content: "";
  width: calc(100% - var(--wot-padding-loose, var(--wot-n-12, 12px)) * 2);
  height: var(--wot-stroke-main, var(--wot-n-1, 1px));
  left: var(--wot-padding-loose, var(--wot-n-12, 12px));
  top: 0;
  transform: scaleY(0.5);
  background: var(--wot-card-content-border-color, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
}