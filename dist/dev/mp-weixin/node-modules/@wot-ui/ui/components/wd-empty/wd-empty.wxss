.wd-empty {
  width: 100%;
  margin: 0 auto;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: var(--wot-empty-padding-bottom, var(--wot-spacing-ultra-loose, var(--wot-n-24, 24px)));
}
.wd-empty  .wd-empty__icon {
  margin: 0 auto;
  width: var(--wot-empty-icon-size, var(--wot-n-98, 98px));
  height: var(--wot-empty-icon-size, var(--wot-n-98, 98px));
  font-size: var(--wot-empty-icon-size, var(--wot-n-98, 98px));
  color: var(--wot-empty-icon-color, var(--wot-icon-disabled, var(--wot-coolgrey-4, #c9cbd4)));
}
.wd-empty__text {
  margin-top: var(--wot-empty-text-margin-top, var(--wot-spacing-loose, var(--wot-n-12, 12px)));
  font-size: var(--wot-empty-text-font-size, var(--wot-typography-body-size-extra-large, var(--wot-n-16, 16px)));
  line-height: var(--wot-empty-text-line-height, var(--wot-typography-body-line-height-size-extra-large, var(--wot-n-24, 24px)));
  font-weight: var(--wot-empty-text-font-weight, var(--wot-typography-body-font-weight-strong, var(--wot-font-weight-medium, 600)));
  color: var(--wot-empty-text-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
  text-align: center;
  word-break: break-all;
}