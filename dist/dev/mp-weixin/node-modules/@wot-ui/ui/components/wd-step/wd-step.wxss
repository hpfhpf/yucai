.wd-step {
  position: relative;
  display: inline-block;
}
.wd-step__header {
  position: relative;
  font-size: 0;
}
.wd-step__header.is-dot .wd-step__line {
  width: calc(100% - 2 * var(--wot-step-line-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px))) - var(--wot-step-dot-size, var(--wot-n-10, 10px)));
  left: calc(var(--wot-step-line-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px))) + var(--wot-step-dot-size, var(--wot-n-10, 10px)));
}
.wd-step__indicator {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  position: relative;
  z-index: 1;
}
.wd-step__circle {
  display: flex;
  justify-content: center;
  align-items: center;
  width: var(--wot-step-indicator-size, var(--wot-n-18, 18px));
  height: var(--wot-step-indicator-size, var(--wot-n-18, 18px));
  border-radius: var(--wot-step-circle-border-radius, var(--wot-radius-full, var(--wot-n-full, 9999px)));
}
.wd-step--finished .wd-step__circle {
  background: var(--wot-step-finished-bg, var(--wot-primary-1, var(--wot-blue-1, #f5f8ff)));
  color: var(--wot-step-circle-text-finished-color, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
  position: relative;
}
.wd-step--finished .wd-step__circle::after {
  position: absolute;
  display: block;
  content: " ";
  pointer-events: none;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
  border: var(--wot-stroke-main, var(--wot-n-1, 1px)) solid var(--wot-step-circle-text-finished-color, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
  box-sizing: border-box;
  border-radius: inherit;
}
.wd-step--finished .wd-step__circle .wd-step__finished-icon {
  color: var(--wot-step-circle-text-finished-color, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-step--finished .wd-step__dot {
  background: var(--wot-step-dot-finished-bg, var(--wot-primary-3, var(--wot-blue-3, #b8cfff)));
  position: relative;
}
.wd-step--finished .wd-step__dot::after {
  position: absolute;
  display: block;
  content: " ";
  pointer-events: none;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
  border: var(--wot-stroke-main, var(--wot-n-1, 1px)) solid var(--wot-step-dot-finished-border-color, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
  box-sizing: border-box;
  border-radius: inherit;
}
.wd-step--finished .wd-step__line {
  background: var(--wot-step-line-active-color, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-step--finished .wd-step__icon {
  color: var(--wot-step-icon-color-active, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-step--finished .wd-step__title {
  color: var(--wot-step-title-color, var(--wot-text-secondary, var(--wot-coolgrey-8, #4e5369)));
}
.wd-step--process .wd-step__circle {
  background: var(--wot-step-process-bg, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
  color: var(--wot-step-circle-text-process-color, var(--wot-text-white, var(--wot-base-white, white)));
}
.wd-step--process .wd-step__dot {
  background: var(--wot-step-dot-process-bg, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
  position: relative;
}
.wd-step--process .wd-step__dot::after {
  position: absolute;
  display: block;
  content: " ";
  pointer-events: none;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
  border: var(--wot-stroke-main, var(--wot-n-1, 1px)) solid var(--wot-step-dot-process-border-color, var(--wot-primary-3, var(--wot-blue-3, #b8cfff)));
  box-sizing: border-box;
  border-radius: inherit;
}
.wd-step--process .wd-step__icon {
  color: var(--wot-step-icon-color-active, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-step--process .wd-step__title {
  color: var(--wot-step-title-color-active, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-step--error .wd-step__circle {
  background: var(--wot-step-error-bg, var(--wot-danger-main, var(--wot-red-6, #f14646)));
  color: var(--wot-step-error-color, var(--wot-text-white, var(--wot-base-white, white)));
}
.wd-step--error .wd-step__dot {
  background: var(--wot-step-dot-error-bg, var(--wot-danger-main, var(--wot-red-6, #f14646)));
}
.wd-step--error .wd-step__icon {
  color: var(--wot-step-icon-error-color, var(--wot-danger-main, var(--wot-red-6, #f14646)));
}
.wd-step--error .wd-step__title {
  color: var(--wot-step-title-error-color, var(--wot-danger-main, var(--wot-red-6, #f14646)));
}
.wd-step--wait .wd-step__circle {
  background: var(--wot-step-circle-bg, var(--wot-filled-strong, var(--wot-coolgrey-3, #e5e6eb)));
  color: var(--wot-step-circle-text-color, var(--wot-text-secondary, var(--wot-coolgrey-8, #4e5369)));
}
.wd-step--wait .wd-step__dot {
  background: var(--wot-step-dot-wait-bg, var(--wot-filled-strong, var(--wot-coolgrey-3, #e5e6eb)));
}
.wd-step--wait .wd-step__icon {
  color: var(--wot-step-icon-color, var(--wot-icon-auxiliary, var(--wot-coolgrey-6, #868a9c)));
}
.wd-step--wait .wd-step__title {
  color: var(--wot-step-title-color, var(--wot-text-secondary, var(--wot-coolgrey-8, #4e5369)));
}
.wd-step  .wd-step__finished-icon, .wd-step  .wd-step__error-icon {
  font-size: var(--wot-step-circle-icon-size, var(--wot-n-12, 12px));
}
.wd-step  .wd-step__icon {
  font-size: var(--wot-step-icon-size, var(--wot-n-18, 18px));
}
.wd-step__circle-text {
  font-size: var(--wot-step-circle-text-font-size, var(--wot-typography-label-size-main, var(--wot-n-12, 12px)));
  line-height: var(--wot-step-circle-text-line-height, var(--wot-typography-label-line-height-size-main, var(--wot-n-18, 18px)));
  font-weight: var(--wot-step-circle-text-font-weight, var(--wot-font-weight-medium, 600));
}
.wd-step__line {
  position: absolute;
  width: calc(100% - 2 * var(--wot-step-line-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px))) - var(--wot-step-indicator-size, var(--wot-n-18, 18px)));
  height: var(--wot-stroke-main, var(--wot-n-1, 1px));
  background: var(--wot-step-line-color, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
  top: 50%;
  left: calc(var(--wot-step-line-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px))) + var(--wot-step-indicator-size, var(--wot-n-18, 18px)));
}
.wd-step__dot {
  position: relative;
  display: block;
  width: var(--wot-step-dot-size, var(--wot-n-10, 10px));
  height: var(--wot-step-dot-size, var(--wot-n-10, 10px));
  border-radius: 50%;
  background: var(--wot-step-line-color, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
  box-sizing: border-box;
}
.wd-step__content {
  margin-top: var(--wot-step-content-margin-top, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)));
  display: flex;
  flex-direction: column;
}
.wd-step__title {
  color: var(--wot-step-title-color, var(--wot-text-secondary, var(--wot-coolgrey-8, #4e5369)));
  font-weight: var(--wot-step-title-font-weight, var(--wot-font-weight-regular, 400));
  font-size: var(--wot-step-title-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-step-title-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
}
.wd-step__description {
  margin-top: var(--wot-step-description-margin-top, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)));
  padding: var(--wot-step-description-padding, var(--wot-padding-zero, var(--wot-n-0, 0px)) var(--wot-padding-ultra-tight, var(--wot-n-2, 2px)));
  color: var(--wot-step-description-color, var(--wot-text-secondary, var(--wot-coolgrey-8, #4e5369)));
  font-weight: var(--wot-step-description-font-weight, var(--wot-font-weight-regular, 400));
  font-size: var(--wot-step-description-font-size, var(--wot-typography-label-size-main, var(--wot-n-12, 12px)));
  line-height: var(--wot-step-description-line-height, var(--wot-typography-label-line-height-size-main, var(--wot-n-18, 18px)));
}
.wd-step.is-center {
  text-align: center;
}
.wd-step.is-center .wd-step__line {
  left: calc(50% + var(--wot-step-line-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px))) + var(--wot-step-indicator-size, var(--wot-n-18, 18px)) / 2);
}
.wd-step.is-center .wd-step__header.is-dot .wd-step__line {
  left: calc(50% + var(--wot-step-line-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px))) + var(--wot-step-dot-size, var(--wot-n-10, 10px)) / 2);
}
.wd-step.is-vertical {
  display: block;
}
.wd-step.is-vertical .wd-step__header {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
}
.wd-step.is-vertical .wd-step__header.is-dot {
  top: var(--wot-step-vertical-header-dot-top, var(--wot-n-6, 6px));
}
.wd-step.is-vertical .wd-step__header.is-dot .wd-step__line {
  left: 50%;
  margin-left: 0;
  margin-top: 0;
}
.wd-step.is-vertical .wd-step__header.is-dot .wd-step__indicator {
  width: var(--wot-step-indicator-size, var(--wot-n-18, 18px));
}
.wd-step.is-vertical .wd-step__content {
  margin-left: var(--wot-step-vertical-content-margin-left, var(--wot-n-32, 32px));
  margin-top: 0;
  padding-bottom: var(--wot-step-vertical-content-padding-bottom, var(--wot-n-20, 20px));
  min-height: var(--wot-step-indicator-size, var(--wot-n-18, 18px));
}
.wd-step.is-vertical .wd-step__line {
  top: calc(var(--wot-step-indicator-size, var(--wot-n-18, 18px)) + var(--wot-step-line-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px))));
  left: 50%;
  width: var(--wot-stroke-main, var(--wot-n-1, 1px));
  height: calc(100% - var(--wot-step-indicator-size, var(--wot-n-18, 18px)) - 2 * var(--wot-step-line-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px))));
  transform: scaleX(0.5);
}
.wd-step.is-vertical .wd-step__header.is-dot .wd-step__line {
  top: calc(var(--wot-step-dot-size, var(--wot-n-10, 10px)) + var(--wot-step-line-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px))));
  height: calc(100% - var(--wot-step-dot-size, var(--wot-n-10, 10px)) - 2 * var(--wot-step-line-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px))));
}
.wd-step.is-vertical .wd-step__icon.is-dot {
  margin-left: 0;
  margin-top: -var(--wot-n-1, 1px);
}