.wd-picker  .wd-picker__popup {
  border-radius: var(--wot-picker-radius, var(--wot-radius-large, var(--wot-n-8, 8px))) var(--wot-picker-radius, var(--wot-radius-large, var(--wot-n-8, 8px))) 0px 0px;
}
.wd-picker__wraper {
  padding-bottom: var(--window-bottom);
  background: var(--wot-picker-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
}
.wd-picker__toolbar {
  position: relative;
  display: flex;
  height: var(--wot-picker-toolbar-height, var(--wot-n-44, 44px));
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}
.wd-picker__action {
  display: block;
  border: none;
  outline: none;
  font-size: var(--wot-picker-action-font-size, var(--wot-typography-body-size-extra-large, var(--wot-n-16, 16px)));
  background: transparent;
  padding: 0 15px;
}
.wd-picker__action--cancel {
  color: var(--wot-picker-action-color-cancel, var(--wot-text-secondary, var(--wot-coolgrey-8, #4e5369)));
}
.wd-picker__action--confirm {
  color: var(--wot-picker-action-color-confirm, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-picker__title {
  display: block;
  flex: 1;
  text-align: center;
  color: var(--wot-picker-title-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
  font-size: var(--wot-picker-title-font-size, var(--wot-typography-title-size-main, var(--wot-n-18, 18px)));
  font-weight: var(--wot-picker-title-font-weight, var(--wot-font-weight-medium, 600));
  line-height: var(--wot-picker-title-line-height, var(--wot-typography-title-line-height-size-main, var(--wot-n-26, 26px)));
}