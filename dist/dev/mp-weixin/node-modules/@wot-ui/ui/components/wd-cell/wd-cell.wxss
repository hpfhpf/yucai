.wd-cell {
  position: relative;
  padding: var(--wot-cell-padding, var(--wot-padding-loose, var(--wot-n-12, 12px)));
  background: var(--wot-cell-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
  text-decoration: none;
  -webkit-tap-highlight-color: transparent;
  box-sizing: border-box;
  width: 100%;
}
.wd-cell.is-border {
  position: relative;
}
.wd-cell.is-border::after {
  position: absolute;
  display: block;
  content: "";
  width: calc(100% - var(--wot-cell-border-margin-horizontal, var(--wot-spacing-loose, var(--wot-n-12, 12px))) * 2);
  height: var(--wot-stroke-main, var(--wot-n-1, 1px));
  left: var(--wot-cell-border-margin-horizontal, var(--wot-spacing-loose, var(--wot-n-12, 12px)));
  top: 0;
  transform: scaleY(0.5);
  background: var(--wot-cell-border-color, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
}
.wd-cell__wrapper {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.wd-cell__wrapper--vertical {
  display: block;
}
.wd-cell__wrapper--vertical .wd-cell__right {
  margin-top: var(--wot-cell-vertical-padding-top, var(--wot-padding-extra-loose, var(--wot-n-16, 16px)));
}
.wd-cell__wrapper--vertical .wd-cell__value {
  text-align: left;
}
.wd-cell__wrapper--vertical .wd-cell__left {
  margin-right: 0;
}
.wd-cell__left {
  position: relative;
  flex: 1;
  display: flex;
  text-align: left;
  font-size: var(--wot-cell-title-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-cell-title-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
  box-sizing: border-box;
}
.wd-cell__right {
  position: relative;
  flex: 1;
  min-width: 0;
}
.wd-cell__title {
  font-size: var(--wot-cell-title-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-cell-title-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
  color: var(--wot-cell-title-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
}
.wd-cell__required {
  font-size: var(--wot-cell-required-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-cell-required-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
  color: var(--wot-cell-required-color, var(--wot-danger-main, var(--wot-red-6, #f14646)));
  margin-left: var(--wot-cell-required-margin, var(--wot-padding-super-tight, var(--wot-n-4, 4px)));
}
.wd-cell__required--left {
  margin-left: 0;
  margin-right: var(--wot-cell-required-margin, var(--wot-padding-super-tight, var(--wot-n-4, 4px)));
}
.wd-cell__label {
  margin-top: var(--wot-cell-label-margin-top, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)));
  font-size: var(--wot-cell-label-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-cell-label-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
  color: var(--wot-cell-label-color, var(--wot-text-auxiliary, var(--wot-coolgrey-6, #868a9c)));
}
.wd-cell  .wd-cell__prefix {
  display: block;
  position: relative;
  margin-right: var(--wot-cell-icon-spacing-right, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)));
  font-size: var(--wot-cell-icon-size, var(--wot-n-20, 20px));
  color: var(--wot-cell-icon-color, var(--wot-icon-secondary, var(--wot-coolgrey-8, #4e5369)));
}
.wd-cell__body {
  display: flex;
  min-width: 0;
}
.wd-cell__value {
  position: relative;
  flex: 1;
  font-size: var(--wot-cell-value-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-cell-value-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
  color: var(--wot-cell-value-color, var(--wot-text-secondary, var(--wot-coolgrey-8, #4e5369)));
  vertical-align: middle;
  word-break: break-all;
}
.wd-cell__value--left {
  text-align: left;
}
.wd-cell__value--right {
  text-align: right;
}
.wd-cell__value--center {
  text-align: center;
}
.wd-cell__value--ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}
.wd-cell__placeholder {
  color: var(--wot-cell-placeholder-color, var(--wot-text-placeholder, var(--wot-coolgrey-5, #a9acb8)));
  font-size: var(--wot-cell-placeholder-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-cell-placeholder-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
}
.wd-cell  .wd-cell__arrow-right {
  display: block;
  margin-left: var(--wot-cell-arrow-margin-left, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  font-size: var(--wot-cell-arrow-size, var(--wot-n-20, 20px));
  color: var(--wot-cell-arrow-color, var(--wot-icon-auxiliary, var(--wot-coolgrey-6, #868a9c)));
}
.wd-cell  .wd-cell__suffix {
  display: block;
  margin-left: var(--wot-cell-arrow-margin-left, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  font-size: var(--wot-cell-icon-size, var(--wot-n-20, 20px));
  color: var(--wot-cell-icon-color, var(--wot-icon-secondary, var(--wot-coolgrey-8, #4e5369)));
}
.wd-cell.is-link {
  -webkit-tap-highlight-color: var(--wot-cell-bg-active, var(--wot-filled-bottom, var(--wot-coolgrey-1, #f7f8fa)));
}
.wd-cell.is-hover {
  background: var(--wot-cell-bg-active, var(--wot-filled-bottom, var(--wot-coolgrey-1, #f7f8fa)));
}
.wd-cell.is-large {
  --wot-cell-padding: var(--wot-cell-padding-large, var(--wot-padding-extra-loose, var(--wot-n-16, 16px)));
  --wot-cell-title-font-size: var(--wot-cell-title-font-size-large, var(--wot-typography-body-size-extra-large, var(--wot-n-16, 16px)));
  --wot-cell-title-line-height: var(--wot-cell-title-line-height-large, var(--wot-typography-body-line-height-size-extra-large, var(--wot-n-24, 24px)));
  --wot-cell-label-font-size: var(--wot-cell-label-font-size-large, var(--wot-typography-body-size-extra-large, var(--wot-n-16, 16px)));
  --wot-cell-label-line-height: var(--wot-cell-label-line-height-large, var(--wot-typography-body-line-height-size-extra-large, var(--wot-n-24, 24px)));
  --wot-cell-value-font-size: var(--wot-cell-value-font-size-large, var(--wot-typography-body-size-extra-large, var(--wot-n-16, 16px)));
  --wot-cell-value-line-height: var(--wot-cell-value-line-height-large, var(--wot-typography-body-line-height-size-extra-large, var(--wot-n-24, 24px)));
}
.wd-cell.is-center .wd-cell__wrapper {
  align-items: center;
}