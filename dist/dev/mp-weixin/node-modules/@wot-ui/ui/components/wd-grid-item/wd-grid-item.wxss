.wd-grid-item {
  box-sizing: border-box;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
  overflow: hidden;
}
.wd-grid-item.is-border::before {
  content: "";
  position: absolute;
  width: 100%;
  height: var(--wot-grid-item-border-width, var(--wot-stroke-main, var(--wot-n-1, 1px)));
  transform: scaleY(0.5);
  background-color: var(--wot-grid-item-border-color, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
  top: 0;
  left: 0;
  z-index: 1;
}
.wd-grid-item.is-border::after {
  content: "";
  position: absolute;
  width: var(--wot-grid-item-border-width, var(--wot-stroke-main, var(--wot-n-1, 1px)));
  transform: scaleX(0.5);
  height: 100%;
  background-color: var(--wot-grid-item-border-color, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
  bottom: 0;
  right: 0;
}
.wd-grid-item.is-first::after {
  content: "";
  position: absolute;
  width: var(--wot-grid-item-border-width, var(--wot-stroke-main, var(--wot-n-1, 1px)));
  transform: scaleX(0.5);
  height: 100%;
  background-color: var(--wot-grid-item-border-color, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
  bottom: 0;
  right: 0;
}
.wd-grid-item.is-right::after {
  display: none;
}
.wd-grid-item.is-last::after {
  display: none;
}
.wd-grid-item__wrapper {
  display: inline-flex;
}
.wd-grid-item__wrapper + .wd-grid-item__text {
  margin-top: var(--wot-grid-item-text-spacing, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)));
}
.wd-grid-item__content {
  height: 100%;
  padding: var(--wot-grid-item-padding, var(--wot-padding-loose, var(--wot-n-12, 12px)) var(--wot-padding-loose, var(--wot-n-12, 12px)));
  background: var(--wot-grid-item-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.wd-grid-item__content.is-square {
  box-sizing: border-box;
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 100%;
}
.wd-grid-item__content.is-center {
  align-items: center;
  justify-content: center;
}
.wd-grid-item__content.is-horizontal {
  flex-direction: row;
}
.wd-grid-item__content.is-horizontal .wd-grid-item__wrapper + .wd-grid-item__text {
  margin-top: 0;
  margin-left: var(--wot-grid-item-text-spacing, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)));
}
.wd-grid-item__content.is-reverse {
  flex-direction: column-reverse;
}
.wd-grid-item__content.is-reverse .wd-grid-item__wrapper + .wd-grid-item__text {
  margin-top: 0;
  margin-bottom: var(--wot-grid-item-text-spacing, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)));
}
.wd-grid-item__content.is-reverse.is-horizontal {
  flex-direction: row-reverse;
}
.wd-grid-item__content.is-reverse.is-horizontal .wd-grid-item__wrapper + .wd-grid-item__text {
  margin-left: 0;
  margin-right: var(--wot-grid-item-text-spacing, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)));
  margin-bottom: 0;
}
.wd-grid-item__content.is-around::after {
  content: " ";
  position: absolute;
  top: 0;
  left: 0;
  width: 200%;
  height: 200%;
  border: var(--wot-grid-item-border-width, var(--wot-stroke-main, var(--wot-n-1, 1px))) solid var(--wot-grid-item-border-color, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
  transform-origin: top left;
  transform: scale(0.5);
  box-sizing: border-box;
}
.wd-grid-item__content--hover {
  background-color: var(--wot-grid-item-hover-bg, var(--wot-feedback-hover, var(--wot-opac-2_04, rgba(0, 0, 0, 0.0392156863)))) !important;
}
.wd-grid-item__text {
  width: 100%;
  font-size: var(--wot-grid-item-font-size, var(--wot-typography-body-size-extra-large, var(--wot-n-16, 16px)));
  line-height: var(--wot-grid-item-line-height, var(--wot-typography-body-line-height-size-extra-large, var(--wot-n-24, 24px)));
  color: var(--wot-grid-item-text-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
}
.wd-grid-item__text.is-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wd-grid-item  .wd-grid-item__icon {
  font-size: var(--wot-grid-item-icon-size, var(--wot-n-32, 32px));
  color: var(--wot-grid-item-icon-color, var(--wot-icon-secondary, var(--wot-coolgrey-8, #4e5369)));
}
.wd-grid-item__badge {
  display: inline-flex;
}