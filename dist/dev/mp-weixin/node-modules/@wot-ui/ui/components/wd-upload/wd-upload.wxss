.wd-upload {
  position: relative;
  display: flex;
  flex-wrap: wrap;
}
.wd-upload__evoke {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: var(--wot-upload-size, var(--wot-n-88, 88px));
  height: var(--wot-upload-size, var(--wot-n-88, 88px));
  border-radius: var(--wot-upload-radius, var(--wot-upload-border-radius, var(--wot-radius-main, var(--wot-n-4, 4px))));
  overflow: hidden;
  background: var(--wot-upload-evoke-bg, var(--wot-filled-bottom, var(--wot-coolgrey-1, #f7f8fa)));
  margin-bottom: var(--wot-upload-row-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  position: relative;
}
.wd-upload__evoke::after {
  position: absolute;
  display: block;
  content: " ";
  pointer-events: none;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
  border: var(--wot-stroke-main, var(--wot-n-1, 1px)) dashed var(--wot-upload-border-color, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
  box-sizing: border-box;
  border-radius: inherit;
}
.wd-upload__evoke.is-disabled {
  color: var(--wot-upload-evoke-color-disabled, var(--wot-text-disabled, var(--wot-coolgrey-4, #c9cbd4)));
}
.wd-upload__evoke.is-disabled .wd-upload__evoke-icon {
  color: var(--wot-upload-evoke-icon-color-disabled, var(--wot-icon-disabled, var(--wot-coolgrey-4, #c9cbd4)));
}
.wd-upload__evoke-num {
  color: var(--wot-upload-evoke-color, var(--wot-text-auxiliary, var(--wot-coolgrey-6, #868a9c)));
  font-size: var(--wot-upload-evoke-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-upload-evoke-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
}
.wd-upload  .wd-upload__evoke-icon {
  font-size: var(--wot-upload-evoke-icon-size, var(--wot-n-32, 32px));
  color: var(--wot-upload-evoke-icon-color, var(--wot-icon-auxiliary, var(--wot-coolgrey-6, #868a9c)));
}
.wd-upload__preview {
  position: relative;
  width: var(--wot-upload-size, var(--wot-n-88, 88px));
  height: var(--wot-upload-size, var(--wot-n-88, 88px));
  border-radius: var(--wot-upload-radius, var(--wot-upload-border-radius, var(--wot-radius-main, var(--wot-n-4, 4px))));
  overflow: hidden;
  margin: var(--wot-upload-preview-margin, var(--wot-spacing-zero, var(--wot-n-0, 0px)) var(--wot-spacing-tight, var(--wot-n-8, 8px)) var(--wot-spacing-tight, var(--wot-n-8, 8px)) var(--wot-spacing-zero, var(--wot-n-0, 0px)));
  position: relative;
}
.wd-upload__preview::after {
  position: absolute;
  display: block;
  content: " ";
  pointer-events: none;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
  border: var(--wot-stroke-main, var(--wot-n-1, 1px)) solid var(--wot-upload-border-color, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
  box-sizing: border-box;
  border-radius: inherit;
}
.wd-upload__preview-list {
  display: flex;
}
.wd-upload__picture, .wd-upload__file, .wd-upload__video {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
}
.wd-upload__file, .wd-upload__video {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: var(--wot-upload-evoke-bg, var(--wot-filled-bottom, var(--wot-coolgrey-1, #f7f8fa)));
}
.wd-upload__video-icon, .wd-upload__file-icon {
  font-size: var(--wot-upload-cover-icon-size, var(--wot-n-24, 24px));
}
.wd-upload__file-name, .wd-upload__video-name {
  width: 100%;
  font-size: var(--wot-upload-file-font-size, var(--wot-typography-label-size-main, var(--wot-n-12, 12px)));
  line-height: var(--wot-upload-file-line-height, var(--wot-typography-label-line-height-size-main, var(--wot-n-18, 18px)));
  color: var(--wot-upload-file-color, var(--wot-text-secondary, var(--wot-coolgrey-8, #4e5369)));
  box-sizing: border-box;
  text-align: center;
  padding: var(--wot-upload-file-padding, var(--wot-padding-zero, var(--wot-n-0, 0px)) var(--wot-padding-tight, var(--wot-n-8, 8px)));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wd-upload  .wd-upload__video-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: var(--wot-upload-video-icon-size, var(--wot-n-24, 24px));
  color: var(--wot-upload-video-icon-color, var(--wot-icon-white, var(--wot-base-white, white)));
}
.wd-upload__close {
  position: absolute;
  right: 0;
  top: 0;
  padding: var(--wot-upload-close-padding, var(--wot-padding-ultra-tight, var(--wot-n-2, 2px)));
  border-radius: var(--wot-upload-close-radius, var(--wot-upload-close-border-radius, var(--wot-radius-zero, var(--wot-n-0, 0px)) var(--wot-radius-zero, var(--wot-n-0, 0px)) var(--wot-radius-zero, var(--wot-n-0, 0px)) var(--wot-radius-main, var(--wot-n-4, 4px))));
  background: var(--wot-upload-close-bg, var(--wot-opacfilled-main-cover, var(--wot-opac-7_55, rgba(0, 0, 0, 0.5490196078))));
}
.wd-upload  .wd-upload__close-icon {
  display: flex;
  color: var(--wot-upload-close-icon-color, var(--wot-icon-white, var(--wot-base-white, white)));
  font-size: var(--wot-upload-close-icon-size, var(--wot-n-16, 16px));
}
.wd-upload__mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--wot-upload-mask-bg, var(--wot-opacfilled-main-cover, var(--wot-opac-7_55, rgba(0, 0, 0, 0.5490196078))));
}
.wd-upload__progress-txt {
  font-size: var(--wot-upload-progress-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-upload-progress-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
  color: var(--wot-upload-progress-color, var(--wot-text-white, var(--wot-base-white, white)));
}
.wd-upload  .wd-upload__icon {
  font-size: var(--wot-upload-preview-icon-size, var(--wot-n-24, 24px));
  color: var(--wot-upload-preview-icon-color, var(--wot-icon-white, var(--wot-base-white, white)));
}
.wd-upload__status-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
}