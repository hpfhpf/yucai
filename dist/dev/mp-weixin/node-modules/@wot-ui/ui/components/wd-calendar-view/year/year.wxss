.wd-year__title {
  font-size: var(--wot-calendar-view-panel-title-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-calendar-view-panel-title-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
  color: var(--wot-calendar-view-panel-title-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
  padding: var(--wot-calendar-view-panel-title-padding, var(--wot-padding-extra-tight, var(--wot-n-6, 6px)) var(--wot-padding-loose, var(--wot-n-12, 12px)));
  font-weight: var(--wot-calendar-view-panel-title-font-weight, var(--wot-font-weight-medium, 600));
  margin: var(--wot-calendar-view-panel-title-margin, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)) var(--wot-spacing-zero, var(--wot-n-0, 0px)));
}
.wd-year__months {
  display: flex;
  flex-wrap: wrap;
  font-size: var(--wot-calendar-view-day-font-size, var(--wot-typography-body-size-extra-large, var(--wot-n-16, 16px)));
  color: var(--wot-calendar-view-day-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
  padding: var(--wot-calendar-view-item-padding, var(--wot-padding-zero, var(--wot-n-0, 0px)) var(--wot-spacing-loose, var(--wot-n-12, 12px)));
}
.wd-year__month {
  position: relative;
  width: 25%;
  height: var(--wot-calendar-view-month-height, var(--wot-n-60, 60px));
  line-height: var(--wot-calendar-view-month-height, var(--wot-n-60, 60px));
  font-weight: var(--wot-calendar-view-month-font-weight, var(--wot-font-weight-medium, 600));
  text-align: center;
  margin-bottom: var(--wot-calendar-view-item-margin-bottom, var(--wot-spacing-super-tight, var(--wot-n-4, 4px)));
}
.wd-year__month.is-disabled .wd-year__month-text {
  color: var(--wot-calendar-view-color-disabled, var(--wot-text-disabled, var(--wot-coolgrey-4, #c9cbd4)));
}
.wd-year__month.is-current {
  color: var(--wot-calendar-view-color-active, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-year__month.is-selected {
  color: var(--wot-calendar-view-color-selected, var(--wot-text-white, var(--wot-base-white, white)));
}
.wd-year__month.is-selected .wd-year__month-container {
  border-radius: var(--wot-calendar-view-border-radius-active, var(--wot-radius-main, var(--wot-n-4, 4px)));
  background: var(--wot-calendar-view-color-active, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-year__month.is-middle {
  background: var(--wot-calendar-view-range-bg, var(--wot-primary-2, var(--wot-blue-2, #e5edff)));
  color: var(--wot-calendar-view-range-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
}
.wd-year__month.is-start {
  color: var(--wot-calendar-view-color-selected, var(--wot-text-white, var(--wot-base-white, white)));
}
.wd-year__month.is-start .wd-year__month-container {
  position: relative;
  z-index: 1;
  background: var(--wot-calendar-view-color-active, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
  border-radius: var(--wot-calendar-view-border-radius-active, var(--wot-radius-main, var(--wot-n-4, 4px))) 0 0 var(--wot-calendar-view-border-radius-active, var(--wot-radius-main, var(--wot-n-4, 4px)));
}
.wd-year__month.is-start::after {
  position: absolute;
  top: 0;
  right: 0;
  left: 50%;
  bottom: 0;
  content: "";
  height: var(--wot-calendar-view-month-height, var(--wot-n-60, 60px));
  background: var(--wot-calendar-view-range-bg, var(--wot-primary-2, var(--wot-blue-2, #e5edff)));
}
.wd-year__month.is-start.is-without-end::after {
  display: none;
}
.wd-year__month.is-end {
  color: var(--wot-calendar-view-color-selected, var(--wot-text-white, var(--wot-base-white, white)));
}
.wd-year__month.is-end .wd-year__month-container {
  position: relative;
  z-index: 1;
  background: var(--wot-calendar-view-color-active, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
  border-radius: 0 var(--wot-calendar-view-border-radius-active, var(--wot-radius-main, var(--wot-n-4, 4px))) var(--wot-calendar-view-border-radius-active, var(--wot-radius-main, var(--wot-n-4, 4px))) 0;
}
.wd-year__month.is-end::after {
  position: absolute;
  top: 0;
  left: 0;
  right: 50%;
  bottom: 0;
  content: "";
  background: var(--wot-calendar-view-range-bg, var(--wot-primary-2, var(--wot-blue-2, #e5edff)));
}
.wd-year__month.is-same {
  color: var(--wot-calendar-view-color-selected, var(--wot-text-white, var(--wot-base-white, white)));
}
.wd-year__month.is-same .wd-year__month-container {
  background: var(--wot-calendar-view-color-active, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
  border-radius: var(--wot-calendar-view-border-radius-active, var(--wot-radius-main, var(--wot-n-4, 4px)));
}
.wd-year__month.is-last-row {
  margin-bottom: 0;
}
.wd-year__month-container {
  position: relative;
  width: var(--wot-calendar-view-month-width, var(--wot-n-60, 60px));
  height: var(--wot-calendar-view-month-height, var(--wot-n-60, 60px));
  margin: 0 auto;
  text-align: center;
}
.wd-year__month-text {
  font-weight: var(--wot-calendar-view-month-font-weight, var(--wot-font-weight-medium, 600));
}
.wd-year__month-top {
  position: absolute;
  top: var(--wot-calendar-view-info-position, var(--wot-spacing-extra-tight, var(--wot-n-6, 6px)));
  left: 0;
  right: 0;
  line-height: var(--wot-calendar-view-info-line-height, var(--wot-typography-label-line-height-size-extra-small, var(--wot-n-16, 16px)));
  font-size: var(--wot-calendar-view-info-font-size, var(--wot-typography-label-size-extra-small, var(--wot-n-10, 10px)));
  text-align: center;
}
.wd-year__month-bottom {
  position: absolute;
  bottom: var(--wot-calendar-view-info-position, var(--wot-spacing-extra-tight, var(--wot-n-6, 6px)));
  left: 0;
  right: 0;
  line-height: var(--wot-calendar-view-info-line-height, var(--wot-typography-label-line-height-size-extra-small, var(--wot-n-16, 16px)));
  font-size: var(--wot-calendar-view-info-font-size, var(--wot-typography-label-size-extra-small, var(--wot-n-10, 10px)));
  text-align: center;
}