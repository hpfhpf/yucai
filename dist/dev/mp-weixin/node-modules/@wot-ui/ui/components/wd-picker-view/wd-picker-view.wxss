.wd-picker-view {
  position: relative;
  padding: var(--wot-picker-view-padding, var(--wot-padding-zero, var(--wot-n-0, 0px)) var(--wot-padding-loose, var(--wot-n-12, 12px)));
  box-sizing: border-box;
  background: var(--wot-picker-view-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
}
.wd-picker-view  .wd-picker-view__mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: var(--wot-picker-view-mask-bg, linear-gradient(180deg, var(--wot-picker-view-mask-start-color, var(--wot-opacwhite-10_85, rgba(255, 255, 255, 0.8509803922))), var(--wot-picker-view-mask-end-color, var(--wot-opacwhite-5_20, rgba(255, 255, 255, 0.2)))), linear-gradient(0deg, var(--wot-picker-view-mask-start-color, var(--wot-opacwhite-10_85, rgba(255, 255, 255, 0.8509803922))), var(--wot-picker-view-mask-end-color, var(--wot-opacwhite-5_20, rgba(255, 255, 255, 0.2)))));
  background-position: top, bottom;
  background-repeat: no-repeat;
  pointer-events: none;
}
.wd-picker-view  .wd-picker-view__roller {
  height: var(--wot-picker-view-column-item-height, var(--wot-n-44, 44px));
  background: var(--wot-picker-view-roller-bg, var(--wot-filled-bottom, var(--wot-coolgrey-1, #f7f8fa)));
  border-radius: 0;
  z-index: 0;
}
.wd-picker-view  .wd-picker-view__roller::before, .wd-picker-view  .wd-picker-view__roller::after {
  display: none;
}
.wd-picker-view  .wd-picker-view__main .wd-picker-view__column:first-child .wd-picker-view__roller {
  border-radius: var(--wot-picker-view-roller-border-radius, var(--wot-radius-main, var(--wot-n-4, 4px))) 0 0 var(--wot-picker-view-roller-border-radius, var(--wot-radius-main, var(--wot-n-4, 4px)));
}
.wd-picker-view  .wd-picker-view__main .wd-picker-view__column:last-child .wd-picker-view__roller {
  border-radius: 0 var(--wot-picker-view-roller-border-radius, var(--wot-radius-main, var(--wot-n-4, 4px))) var(--wot-picker-view-roller-border-radius, var(--wot-radius-main, var(--wot-n-4, 4px))) 0;
}
.wd-picker-view__column {
  flex: 1;
}
.wd-picker-view__column-item {
  padding: var(--wot-picker-view-column-item-padding, 0 var(--wot-padding-tight, var(--wot-n-8, 8px)));
  color: var(--wot-picker-view-column-item-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
  font-size: var(--wot-picker-view-column-item-font-size, var(--wot-typography-body-size-extra-large, var(--wot-n-16, 16px)));
  line-height: var(--wot-picker-view-column-item-height, var(--wot-n-44, 44px));
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wd-picker-view__column-item--disabled {
  color: var(--wot-picker-view-column-item-disabled-color, var(--wot-text-disabled, var(--wot-coolgrey-4, #c9cbd4)));
}
.wd-picker-view__column-item--active {
  font-weight: var(--wot-picker-view-column-item-font-weight-active, var(--wot-font-weight-medium, 600));
}