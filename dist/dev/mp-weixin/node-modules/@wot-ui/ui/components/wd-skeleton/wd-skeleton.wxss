.wd-skeleton {
  box-sizing: border-box;
}
.wd-skeleton__row {
  justify-content: space-between;
  margin-bottom: var(--wot-skeleton-row-margin-bottom, var(--wot-spacing-loose, var(--wot-n-12, 12px)));
  display: flex;
  align-items: center;
}
.wd-skeleton__row:only-child, .wd-skeleton__row:last-child {
  margin-bottom: 0;
}
.wd-skeleton__col {
  border-radius: var(--wot-skeleton-text-border-radius, var(--wot-radius-small, var(--wot-n-2, 2px)));
  background-color: var(--wot-skeleton-col-bg, var(--wot-filled-strong, var(--wot-coolgrey-3, #e5e6eb)));
  display: flex;
  align-items: center;
  justify-content: center;
}
.wd-skeleton__col:first-child:last-child, .wd-skeleton__col:last-child {
  margin-right: 0;
}
.wd-skeleton--type-text {
  width: 100%;
  height: var(--wot-skeleton-text-height, var(--wot-n-16, 16px));
  border-radius: var(--wot-skeleton-text-border-radius, var(--wot-radius-small, var(--wot-n-2, 2px)));
}
.wd-skeleton--type-rect {
  width: 100%;
  height: var(--wot-skeleton-rect-height, var(--wot-n-16, 16px));
  border-radius: var(--wot-skeleton-rect-border-radius, var(--wot-radius-main, var(--wot-n-4, 4px)));
}
.wd-skeleton--type-circle {
  flex-shrink: 0;
  width: var(--wot-skeleton-circle-height, var(--wot-n-48, 48px));
  height: var(--wot-skeleton-circle-height, var(--wot-n-48, 48px));
  border-radius: var(--wot-skeleton-circle-border-radius, var(--wot-radius-full, var(--wot-n-full, 9999px)));
}
.wd-skeleton--animation-gradient {
  position: relative;
  overflow-x: hidden;
}
.wd-skeleton--animation-gradient::after {
  content: " ";
  position: absolute;
  animation: wd-skeleton-gradient 1.5s linear 2s infinite;
  background: linear-gradient(90deg, transparent, var(--wot-skeleton-animation-gradient, var(--wot-filled-bottom, var(--wot-coolgrey-1, #f7f8fa))), transparent);
  inset: 0;
}
.wd-skeleton--animation-flashed {
  animation: wd-skeleton-flashed 2s linear 2s infinite;
}
@keyframes wd-skeleton-gradient {
0% {
    transform: translateX(-100%) skewX(-15deg);
}
100% {
    transform: translateX(100%) skewX(-15deg);
}
}
@keyframes wd-skeleton-flashed {
0% {
    opacity: 1;
}
50% {
    opacity: var(--wot-skeleton-animation-flashed-opacity, var(--wot-opacity-backdrop, 0.3));
    background: var(--wot-skeleton-animation-flashed, var(--wot-filled-bottom, var(--wot-coolgrey-1, #f7f8fa)));
}
100% {
    opacity: 1;
}
}