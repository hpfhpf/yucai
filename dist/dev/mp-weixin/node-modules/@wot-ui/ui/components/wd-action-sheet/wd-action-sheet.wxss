.wd-action-sheet-wrapper  .wd-action-sheet-wrapper__popup {
  border-radius: var(--wot-action-sheet-radius, var(--wot-radius-large, var(--wot-n-8, 8px))) var(--wot-action-sheet-radius, var(--wot-radius-large, var(--wot-n-8, 8px))) 0 0;
}
.wd-action-sheet {
  background: var(--wot-action-sheet-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
  border-radius: var(--wot-action-sheet-radius, var(--wot-radius-large, var(--wot-n-8, 8px))) var(--wot-action-sheet-radius, var(--wot-radius-large, var(--wot-n-8, 8px))) 0 0;
  overflow: hidden;
}
.wd-action-sheet__actions {
  max-height: 50vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.wd-action-sheet__action {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: var(--wot-action-sheet-action-font-size, var(--wot-typography-title-size-main, var(--wot-n-18, 18px)));
  line-height: var(--wot-action-sheet-action-line-height, var(--wot-typography-title-line-height-size-main, var(--wot-n-26, 26px)));
  color: var(--wot-action-sheet-action-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
  background: var(--wot-action-sheet-action-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
  padding: var(--wot-action-sheet-action-padding, var(--wot-padding-extra-loose, var(--wot-n-16, 16px)) var(--wot-padding-loose, var(--wot-n-12, 12px)));
  box-sizing: border-box;
}
.wd-action-sheet__action.is-border {
  position: relative;
}
.wd-action-sheet__action.is-border::after {
  position: absolute;
  display: block;
  content: "";
  width: 100%;
  height: var(--wot-stroke-main, var(--wot-n-1, 1px));
  left: 0;
  bottom: 0;
  background: var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb));
}
.wd-action-sheet__action:not(.wd-action-sheet__action--disabled):not(.wd-action-sheet__action--loading):active {
  background: var(--wot-action-sheet-active-bg, var(--wot-filled-content, var(--wot-coolgrey-2, #f2f3f5)));
}
.wd-action-sheet__action--disabled {
  color: var(--wot-action-sheet-disabled-color, var(--wot-text-disabled, var(--wot-coolgrey-4, #c9cbd4)));
  cursor: not-allowed;
}
.wd-action-sheet__action--loading {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: initial;
}
.wd-action-sheet  .wd-action-sheet__action-loading {
  width: var(--wot-action-sheet-loading-size, var(--wot-n-20, 20px));
  height: var(--wot-action-sheet-loading-size, var(--wot-n-20, 20px));
}
.wd-action-sheet__description {
  margin-top: var(--wot-action-sheet-description-margin-top, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  font-size: var(--wot-action-sheet-description-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-action-sheet-description-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
  color: var(--wot-action-sheet-description-color, var(--wot-text-auxiliary, var(--wot-coolgrey-6, #868a9c)));
}
.wd-action-sheet__gap {
  height: var(--wot-action-sheet-gap-height, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  background: var(--wot-action-sheet-gap-bg, var(--wot-filled-bottom, var(--wot-coolgrey-1, #f7f8fa)));
}
.wd-action-sheet__cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--wot-action-sheet-cancel-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
  color: var(--wot-action-sheet-cancel-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
  font-size: var(--wot-action-sheet-cancel-font-size, var(--wot-typography-title-size-main, var(--wot-n-18, 18px)));
  line-height: var(--wot-action-sheet-cancel-line-height, var(--wot-typography-title-line-height-size-main, var(--wot-n-26, 26px)));
  padding: var(--wot-action-sheet-cancel-padding, var(--wot-padding-extra-loose, var(--wot-n-16, 16px)) var(--wot-padding-loose, var(--wot-n-12, 12px)));
}
.wd-action-sheet__cancel:active {
  background: var(--wot-action-sheet-active-bg, var(--wot-filled-content, var(--wot-coolgrey-2, #f2f3f5)));
}
.wd-action-sheet__title {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--wot-action-sheet-title-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
  height: var(--wot-action-sheet-title-height, var(--wot-n-56, 56px));
  font-size: var(--wot-action-sheet-title-font-size, var(--wot-typography-title-size-main, var(--wot-n-18, 18px)));
  font-weight: var(--wot-action-sheet-title-font-weight, var(--wot-font-weight-medium, 600));
  line-height: var(--wot-action-sheet-title-line-height, var(--wot-typography-title-line-height-size-main, var(--wot-n-26, 26px)));
}
.wd-action-sheet  .wd-action-sheet__close {
  position: absolute;
  top: 50%;
  right: var(--wot-action-sheet-close-right, var(--wot-spacing-loose, var(--wot-n-12, 12px)));
  color: var(--wot-action-sheet-close-color, var(--wot-icon-secondary, var(--wot-coolgrey-8, #4e5369)));
  font-size: var(--wot-action-sheet-close-font-size, var(--wot-n-24, 24px));
  transform: translateY(-50%);
}
.wd-action-sheet__panels-wrap {
  padding: var(--wot-action-sheet-panels-wrap-padding, var(--wot-padding-main, var(--wot-n-10, 10px)) var(--wot-padding-zero, var(--wot-n-0, 0px)));
  background: var(--wot-action-sheet-panel-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
}
.wd-action-sheet__panels {
  padding: var(--wot-action-sheet-panels-padding, var(--wot-padding-zero, var(--wot-n-0, 0px)) var(--wot-padding-main, var(--wot-n-10, 10px)));
}
.wd-action-sheet__panels-content {
  display: flex;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
.wd-action-sheet__panel {
  width: var(--wot-action-sheet-panel-width, var(--wot-n-88, 88px));
  flex: 0 0 auto;
  padding: var(--wot-action-sheet-panel-padding, var(--wot-padding-main, var(--wot-n-10, 10px)) var(--wot-padding-zero, var(--wot-n-0, 0px)));
}
.wd-action-sheet  .wd-action-sheet__panel-img {
  display: block;
  font-size: var(--wot-action-sheet-panel-img-size, var(--wot-n-24, 24px));
  width: var(--wot-action-sheet-panel-img-size, var(--wot-n-24, 24px));
  height: var(--wot-action-sheet-panel-img-size, var(--wot-n-24, 24px));
  margin: var(--wot-action-sheet-panel-img-spacing, var(--wot-spacing-zero, var(--wot-n-0, 0px)) auto var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  border-radius: var(--wot-action-sheet-panel-img-radius, var(--wot-radius-main, var(--wot-n-4, 4px)));
}
.wd-action-sheet__panel-title {
  font-size: var(--wot-action-sheet-panel-title-font-size, var(--wot-typography-label-size-main, var(--wot-n-12, 12px)));
  line-height: var(--wot-action-sheet-panel-title-line-height, var(--wot-typography-label-line-height-size-main, var(--wot-n-18, 18px)));
  color: var(--wot-action-sheet-panel-title-color, var(--wot-text-auxiliary, var(--wot-coolgrey-6, #868a9c)));
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}