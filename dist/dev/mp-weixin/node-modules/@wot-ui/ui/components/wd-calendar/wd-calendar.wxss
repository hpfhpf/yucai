.wd-calendar__header {
  position: relative;
  overflow: hidden;
}
.wd-calendar  .wd-calendar__popup {
  background: var(--wot-calendar-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
}
.wd-calendar__tabs {
  box-sizing: border-box;
  width: var(--wot-calendar-tabs-width, 100%);
  padding: var(--wot-calendar-tabs-padding, var(--wot-padding-zero, var(--wot-n-0, 0px)) var(--wot-padding-extra-loose, var(--wot-n-16, 16px)));
}
.wd-calendar__shortcuts {
  padding: var(--wot-calendar-shortcuts-padding, var(--wot-padding-extra-tight, var(--wot-n-6, 6px)) var(--wot-padding-zero, var(--wot-n-0, 0px)));
  text-align: center;
}
.wd-calendar  .wd-calendar__tag {
  margin-right: var(--wot-calendar-tag-spacing-right, var(--wot-spacing-extra-loose, var(--wot-n-16, 16px)));
}
.wd-calendar  .wd-calendar__tag.is-last-tag {
  margin-right: 0;
}
.wd-calendar__range {
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: var(--wot-calendar-range-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  padding: var(--wot-calendar-range-padding, var(--wot-padding-zero, var(--wot-n-0, 0px)) var(--wot-padding-loose, var(--wot-n-12, 12px)) var(--wot-padding-extra-loose, var(--wot-n-16, 16px)));
}
.wd-calendar__range-item {
  flex: 1;
  color: var(--wot-calendar-range-item-color, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
  font-size: var(--wot-calendar-range-item-font-size, var(--wot-typography-body-size-extra-large, var(--wot-n-16, 16px)));
  font-weight: var(--wot-calendar-range-item-font-weight, var(--wot-font-weight-medium, 600));
  line-height: var(--wot-calendar-range-item-line-height, var(--wot-typography-body-line-height-size-extra-large, var(--wot-n-24, 24px)));
  padding: var(--wot-calendar-range-item-padding, var(--wot-spacing-loose, var(--wot-n-12, 12px)) var(--wot-spacing-zero, var(--wot-n-0, 0px)));
  text-align: center;
  position: relative;
}
.wd-calendar__range-item::after {
  position: absolute;
  display: block;
  content: "";
  width: 100%;
  height: var(--wot-stroke-main, var(--wot-n-1, 1px));
  left: 0;
  bottom: 0;
  background: var(--wot-calendar-range-item-line-color, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-calendar__range-item.is-placeholder {
  color: var(--wot-calendar-range-item-color-placeholder, var(--wot-text-placeholder, var(--wot-coolgrey-5, #a9acb8)));
  position: relative;
}
.wd-calendar__range-item.is-placeholder::after {
  position: absolute;
  display: block;
  content: "";
  width: 100%;
  height: var(--wot-stroke-main, var(--wot-n-1, 1px));
  left: 0;
  bottom: 0;
  background: var(--wot-calendar-range-item-line-color-placeholder, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
}
.wd-calendar__range-separator {
  width: var(--wot-calendar-range-separator-width, var(--wot-n-8, 8px));
  height: var(--wot-calendar-range-separator-height, var(--wot-stroke-main, var(--wot-n-1, 1px)));
  position: relative;
  margin: var(--wot-calendar-range-separator-margin, var(--wot-spacing-zero, var(--wot-n-0, 0px)) var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  background: var(--wot-calendar-range-separator-color, var(--wot-text-auxiliary, var(--wot-coolgrey-6, #868a9c)));
}
.wd-calendar__confirm {
  display: flex;
  align-items: center;
  padding: var(--wot-calendar-confirm-padding, var(--wot-padding-tight, var(--wot-n-8, 8px)) var(--wot-padding-loose, var(--wot-n-12, 12px)));
  position: relative;
}
.wd-calendar__confirm::after {
  position: absolute;
  display: block;
  content: "";
  width: 100%;
  height: var(--wot-stroke-main, var(--wot-n-1, 1px));
  left: 0;
  top: 0;
  background: var(--wot-calendar-confirm-border-color, var(--wot-border-light, var(--wot-coolgrey-2, #f2f3f5)));
}
.wd-calendar__confirm-btn-wrapper {
  flex-grow: 1;
}