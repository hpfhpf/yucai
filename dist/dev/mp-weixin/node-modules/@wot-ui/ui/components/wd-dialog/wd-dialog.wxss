 .wd-dialog {
  background: transparent;
}
.wd-dialog__container {
  background: var(--wot-dialog-bg, var(--wot-filled-oppo, var(--wot-base-white, white)));
  border-radius: var(--wot-dialog-radius, var(--wot-radius-large, var(--wot-n-8, 8px)));
  overflow: hidden;
  width: var(--wot-dialog-width, 280px);
  box-sizing: border-box;
}
.wd-dialog__img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: var(--wot-dialog-img-border-radius, var(--wot-radius-large, var(--wot-n-8, 8px)));
}
.wd-dialog__img + .wd-dialog__title {
  margin-top: var(--wot-dialog-body-element-spacing-large, var(--wot-spacing-extra-loose, var(--wot-n-16, 16px)));
}
.wd-dialog__img + .wd-dialog__content {
  margin-top: var(--wot-dialog-body-element-spacing-large, var(--wot-spacing-extra-loose, var(--wot-n-16, 16px)));
}
.wd-dialog__body.is-prompt .wd-dialog__img + .wd-dialog__content {
  margin-top: var(--wot-dialog-body-element-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
}
.wd-dialog__title {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: var(--wot-dialog-title-font-size, var(--wot-typography-body-size-extra-large, var(--wot-n-16, 16px)));
  color: var(--wot-dialog-title-color, var(--wot-text-main, var(--wot-coolgrey-10, #1d1f29)));
  line-height: var(--wot-dialog-title-line-height, var(--wot-typography-body-line-height-size-extra-large, var(--wot-n-24, 24px)));
  font-weight: var(--wot-dialog-title-font-weight, var(--wot-font-weight-medium, 600));
}
.wd-dialog__title + .wd-dialog__content {
  margin-top: var(--wot-dialog-body-element-spacing, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
}
.wd-dialog__body {
  padding: var(--wot-dialog-body-padding, var(--wot-padding-super-loose, var(--wot-n-20, 20px)) var(--wot-padding-super-loose, var(--wot-n-20, 20px)) 0);
}
.wd-dialog__body.is-prompt .wd-dialog__content {
  padding-top: var(--wot-dialog-content-input-padding-top, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
}
.wd-dialog__content {
  max-height: var(--wot-dialog-content-max-height, 340px);
  text-align: center;
  overflow: auto;
}
.wd-dialog__content::-webkit-scrollbar {
  width: var(--wot-dialog-scrollbar-width, var(--wot-stroke-bold, var(--wot-n-2, 2px)));
}
.wd-dialog__content::-webkit-scrollbar-thumb {
  width: var(--wot-dialog-scrollbar-width, var(--wot-stroke-bold, var(--wot-n-2, 2px)));
  background: var(--wot-dialog-scrollbar-color, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
  border-radius: calc(var(--wot-dialog-scrollbar-width, var(--wot-stroke-bold, var(--wot-n-2, 2px))) / 2);
}
.wd-dialog__content-text {
  color: var(--wot-dialog-content-color, var(--wot-text-secondary, var(--wot-coolgrey-8, #4e5369)));
  font-size: var(--wot-dialog-content-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  line-height: var(--wot-dialog-content-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
}
.wd-dialog__input {
  background: var(--wot-dialog-content-input-bg, var(--wot-filled-bottom, var(--wot-coolgrey-1, #f7f8fa)));
}
.wd-dialog__input-error {
  color: var(--wot-dialog-content-input-error-color, var(--wot-danger-main, var(--wot-red-6, #f14646)));
  font-size: var(--wot-dialog-content-input-font-size, var(--wot-typography-label-size-main, var(--wot-n-12, 12px)));
  line-height: var(--wot-dialog-content-input-line-height, var(--wot-typography-label-line-height-size-main, var(--wot-n-18, 18px)));
  padding-top: var(--wot-dialog-content-input-padding-top, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  text-align: left;
}
.wd-dialog__actions {
  padding: var(--wot-dialog-actions-padding, var(--wot-padding-super-loose, var(--wot-n-20, 20px)));
}
.wd-dialog__actions  .wd-dialog__actions-btn:not(:last-child) {
  margin-right: var(--wot-dialog-actions-spacing, var(--wot-spacing-loose, var(--wot-n-12, 12px)));
}
.wd-dialog__actions  .wd-dialog__actions-btn--confirm {
  font-weight: var(--wot-dialog-actions-confirm-font-weight, var(--wot-font-weight-medium, 600));
}
.wd-dialog__actions--vertical {
  flex-direction: column;
  padding: var(--wot-dialog-actions-padding-vertical, var(--wot-padding-super-loose, var(--wot-n-20, 20px)) var(--wot-padding-loose, var(--wot-n-12, 12px)) var(--wot-padding-loose, var(--wot-n-12, 12px)));
}
.wd-dialog__actions--vertical  .wd-dialog__actions-btn:not(:last-child) {
  margin-right: 0;
  margin-bottom: var(--wot-dialog-actions-spacing-vertical, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
}
.wd-dialog__actions.is-text {
  padding: var(--wot-padding-super-loose, var(--wot-n-20, 20px)) 0 0;
}
.wd-dialog__actions.is-text  .wd-dialog__actions-btn {
  margin: 0;
  border-radius: 0;
  padding: var(--wot-dialog-action-text-button-padding, var(--wot-padding-loose, var(--wot-n-12, 12px)) var(--wot-padding-extra-loose, var(--wot-n-16, 16px)));
  border-top: var(--wot-dialog-action-text-border, var(--wot-stroke-light, var(--wot-n-05, 0.5px))) solid var(--wot-dialog-action-text-border-color, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
}
.wd-dialog__actions.is-text  .wd-dialog__actions-btn:not(:last-child) {
  border-right: var(--wot-dialog-action-text-border, var(--wot-stroke-light, var(--wot-n-05, 0.5px))) solid var(--wot-dialog-action-text-border-color, var(--wot-border-main, var(--wot-coolgrey-3, #e5e6eb)));
}
.wd-dialog__actions.is-text.wd-dialog__actions--vertical  .wd-dialog__actions-btn:not(:last-child) {
  border-right: none;
}
.wd-dialog__flex {
  display: flex;
}
.wd-dialog__block {
  display: block;
}
.wd-dialog__icon {
  font-size: var(--wot-dialog-icon-size, var(--wot-n-48, 48px));
  line-height: var(--wot-dialog-icon-size, var(--wot-n-48, 48px));
  margin: 0 auto;
  margin-bottom: var(--wot-dialog-icon-margin-bottom, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  color: var(--wot-dialog-primary-color, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-dialog__icon.is-success {
  color: var(--wot-dialog-success-color, var(--wot-success-main, var(--wot-green-6, #12b886)));
}
.wd-dialog__icon.is-info {
  color: var(--wot-dialog-primary-color, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-dialog__icon.is-warning {
  color: var(--wot-dialog-warning-color, var(--wot-warning-main, var(--wot-orange-6, #f57f00)));
}
.wd-dialog__icon.is-danger {
  color: var(--wot-dialog-error-color, var(--wot-danger-main, var(--wot-red-6, #f14646)));
}
.wd-dialog__close {
  position: absolute;
  top: var(--wot-dialog-close-icon-top, var(--wot-spacing-extra-loose, var(--wot-n-16, 16px)));
  right: var(--wot-dialog-close-icon-right, var(--wot-spacing-extra-loose, var(--wot-n-16, 16px)));
  font-size: var(--wot-dialog-close-icon-size, var(--wot-n-18, 18px));
  color: var(--wot-dialog-close-icon-color, var(--wot-icon-secondary, var(--wot-coolgrey-8, #4e5369)));
}