generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===========================
// 枚举
// ===========================

enum UserRole {
  SEEKER
  RECRUITER
  ADMIN
  SUPER_ADMIN
}

enum Gender {
  UNKNOWN
  MALE
  FEMALE
}

enum Degree {
  ANY
  JUNIOR_HIGH
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTOR
}

enum JobNature {
  FULL_TIME
  PART_TIME
  INTERNSHIP
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum DeliveryStatus {
  PENDING
  VIEWED
  INTERVIEW
  REJECTED
  ACCEPTED
}

enum MessageType {
  INVITE
  CHAT
  SYSTEM
}

enum VerifyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CertifierType {
  ADMIN
  PEER
}

enum CertStatus {
  PENDING
  APPROVED
  REVOKED
}

enum RecStatus {
  DONE
  REVIEW
}

// 职级体系：骨干员工 / 团队主管 / 中高层管理 / 决策层
// 数值顺序对应过滤逻辑（越高越资深），Prisma 枚举按声明顺序比较
enum CareerLevel {
  IC        // 骨干员工（高级专员/资深工程师）
  LEAD      // 团队主管（组长/技术 Leader）
  MGR_DIR   // 中高层管理（部门经理/总监）
  VP_C      // 决策层（VP/C-Level/合伙人）
}

// ===========================
// 用户表
// ===========================

model User {
  id           String    @id @default(cuid())
  phone        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(SEEKER)
  nickname     String?
  avatarUrl    String?   @map("avatar_url")
  status       Int       @default(1) // 1:正常 0:禁用
  idVerifiedAt DateTime? @map("id_verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  seekerProfile    SeekerProfile?
  recruiter        Recruiter?
  sentMessages     Message[]             @relation("MessageSender")
  receivedMessages Message[]             @relation("MessageReceiver")
  deliveries       Delivery[]
  favorites        JobFavorite[]
  idVerification   IdentityVerification?
  certTargets      WorkCertification[]   @relation("CertTarget")
  certifierOf      WorkCertification[]   @relation("Certifier")
  recommendations  Recommendation[]

  @@index([role])
  @@map("users")
}

// ===========================
// 求职者详细信息
// ===========================

model SeekerProfile {
  id        String    @id @default(cuid())
  userId    String    @unique @map("user_id")
  realName  String?   @map("real_name")
  gender    Gender    @default(UNKNOWN)
  birthDate DateTime? @map("birth_date")
  city      String?
  roleTitle            String?      @map("role_title")
  selfDesc             String?      @db.Text @map("self_desc")
  currentAnnualSalary  Int?         @map("current_annual_salary") // 当前综合年薪，万/年
  currentLevel         CareerLevel? @map("current_level")          // 当前职级
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user        User                @relation(fields: [userId], references: [id])
  educations  Education[]
  workExps    WorkExperience[]
  projectExps ProjectExperience[]

  @@map("seeker_profiles")
}

// ===========================
// 教育经历
// ===========================

model Education {
  id        String    @id @default(cuid())
  profileId String    @map("profile_id")
  school    String
  major     String?
  degree    Degree    @default(ANY)
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  profile SeekerProfile @relation(fields: [profileId], references: [id])

  @@index([profileId])
  @@map("educations")
}

// ===========================
// 工作经历
// ===========================

model WorkExperience {
  id        String    @id @default(cuid())
  profileId String    @map("profile_id")
  companyId String?   @map("company_id")
  company   String
  title     String
  city      String?
  salaryMin Int?      @map("salary_min")
  salaryMax Int?      @map("salary_max")
  skillTags Json?     @map("skill_tags")
  content   String?   @db.Text
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  profile       SeekerProfile      @relation(fields: [profileId], references: [id])
  companyRef    Company?           @relation(fields: [companyId], references: [id])
  certification WorkCertification?

  @@index([profileId])
  @@map("work_experiences")
}

// ===========================
// 项目经历
// ===========================

model ProjectExperience {
  id        String    @id @default(cuid())
  profileId String    @map("profile_id")
  name      String
  role      String?
  techTags  Json?     @map("tech_tags")
  content   String?   @db.Text
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  profile SeekerProfile @relation(fields: [profileId], references: [id])

  @@index([profileId])
  @@map("project_experiences")
}

// ===========================
// 企业表
// ===========================

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  logoUrl     String?  @map("logo_url")
  industry    String?
  scale       String?
  description String?  @db.Text
  province    String?
  city        String?
  district    String?
  address     String?
  creditScore Int      @default(0) @map("credit_score")
  isVerified  Boolean  @default(false) @map("is_verified")
  status      Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")

  recruiters Recruiter[]
  jobs       Job[]
  workExps   WorkExperience[]

  @@index([name])
  @@map("companies")
}

// ===========================
// 招聘官表
// ===========================

model Recruiter {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  companyId    String?  @map("company_id")
  realName     String?  @map("real_name")
  department   String?
  contactPhone String?  @map("contact_phone")
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
  jobs    Job[]

  @@map("recruiters")
}

// ===========================
// 职位表
// ===========================

model Job {
  id          String    @id @default(cuid())
  recruiterId String    @map("recruiter_id")
  companyId   String    @map("company_id")
  title       String
  nature      JobNature @default(FULL_TIME)
  province    String?
  city        String?
  district    String?
  address     String?
  salaryRange    String?     @map("salary_range")
  annualSalaryMin Int?       @map("annual_salary_min") // 年薪下限，万/年
  annualSalaryMax Int?       @map("annual_salary_max") // 年薪上限，万/年
  levelTag       CareerLevel? @map("level_tag")        // AI 异步打标的职级（可空）
  minDegree      Degree      @default(ANY) @map("min_degree")
  minExpYears Int       @default(0) @map("min_exp_years")
  description String    @db.Text
  perks       Json?
  status      JobStatus @default(ACTIVE)
  viewCount   Int       @default(0) @map("view_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  recruiter  Recruiter   @relation(fields: [recruiterId], references: [id])
  company    Company     @relation(fields: [companyId], references: [id])
  deliveries Delivery[]
  favorites  JobFavorite[]

  @@index([companyId])
  @@index([status, createdAt])
  @@index([city, status])
  @@map("jobs")
}

// ===========================
// 简历投递
// ===========================

model Delivery {
  id               String         @id @default(cuid())
  userId           String         @map("user_id")
  jobId            String         @map("job_id")
  status           DeliveryStatus @default(PENDING)
  creditAuthorized Boolean        @default(false) @map("credit_authorized")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("deliveries")
}

// ===========================
// 消息表
// ===========================

model Message {
  id         String      @id @default(cuid())
  type       MessageType
  senderId   String      @map("sender_id")
  receiverId String      @map("receiver_id")
  jobId      String?     @map("job_id")
  content    String      @db.Text
  extra      Json?
  isRead     Boolean     @default(false) @map("is_read")
  createdAt  DateTime    @default(now()) @map("created_at")

  sender   User @relation("MessageSender", fields: [senderId], references: [id])
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id])

  @@index([receiverId, isRead])
  @@index([senderId, receiverId])
  @@map("messages")
}

// ===========================
// 实名认证
// ===========================

model IdentityVerification {
  id           String       @id @default(cuid())
  userId       String       @unique @map("user_id")
  realName     String       @map("real_name")
  idNumber     String       @map("id_number")
  idFrontUrl   String?      @map("id_front_url")
  idBackUrl    String?      @map("id_back_url")
  idValidDate  DateTime?    @map("id_valid_date")
  status       VerifyStatus @default(PENDING)
  rejectReason String?      @map("reject_reason")
  reviewedAt   DateTime?    @map("reviewed_at")
  reviewerId   String?      @map("reviewer_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("identity_verifications")
}

// ===========================
// 工作认证（user + company 粒度）
// 同一用户同一公司只需认证一次
// ===========================

model WorkCertification {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  workExpId      String        @unique @map("work_exp_id")
  certifierId    String?       @map("certifier_id")
  certifierType  CertifierType @map("certifier_type")
  status         CertStatus    @default(PENDING)
  note           String?
  relationship   String?       @map("relationship")   // SUPERVISOR | COLLEAGUE | HR
  anonymous      Boolean       @default(false)
  knowFrom       DateTime?     @map("know_from")
  knowTo         DateTime?     @map("know_to")
  recommendation String?       @db.Text @map("recommendation")
  shareToken     String?       @unique @map("share_token")
  shareExpireAt  DateTime?     @map("share_expire_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user      User           @relation("CertTarget", fields: [userId], references: [id])
  certifier User?          @relation("Certifier", fields: [certifierId], references: [id])
  workExp   WorkExperience @relation(fields: [workExpId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([certifierId])
  @@map("work_certifications")
}

// ===========================
// 职位收藏
// ===========================

model JobFavorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  jobId     String   @map("job_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  @@unique([userId, jobId])
  @@index([userId])
  @@map("job_favorites")
}

// ===========================
// 推荐记录
// ===========================

model Recommendation {
  id            String    @id @default(cuid())
  recommenderId String    @map("recommender_id")
  jobId         String    @map("job_id")
  company       String
  content       String?
  status        RecStatus @default(REVIEW)
  createdAt     DateTime  @default(now()) @map("created_at")

  recommender User @relation(fields: [recommenderId], references: [id])

  @@index([recommenderId])
  @@map("recommendations")
}
